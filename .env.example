# Used when the settings file is first created (see NILO_BOOTSTRAP_CONFIG).
# Once NILO_CONFIG exists, edit it from the web console. These variables are
# not applied again on later starts.
# Nested fields use a double underscore.

NILO_CONFIG=/etc/nilo-datalake/settings.yaml
NILO_INGEST__API_KEY=
NILO_PULL__MONGO__URI=
NILO_PULL__MINIO__ACCESS_KEY=
NILO_PULL__MINIO__SECRET_KEY=
NILO_PULL__HTTP__API_KEY=
NILO_EDGE__API_KEY=
NILO_CONSOLE__USERNAME=admin
NILO_CONSOLE__PASSWORD=
