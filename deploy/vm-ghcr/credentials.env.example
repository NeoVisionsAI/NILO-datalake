# Copy to credentials.env or run ./configure.sh.
# Never commit credentials.env. The file mode on the VM must be 600.
#
# These values are copied into /data/config/settings.yaml the first time the
# datalake container starts. After that file exists, change schedule, paths,
# and passwords in the web console. Editing this file does not update a
# running archive. A new MinIO password applies only on a new MinIO volume.
#
# nilo-media keeps capture sessions (sessions/{id}/...).
# nilo-backups keeps database dump files. This stack does not connect to MongoDB.

SERVICE_IMAGE=ghcr.io/neovisionsai/nilo-datalake:latest
HOST_PORT=8088

NILO_CONSOLE_USERNAME=admin
NILO_CONSOLE_PASSWORD=CHANGE_ME
NILO_INGEST_API_KEY=CHANGE_ME

MINIO_ROOT_USER=nilo
MINIO_ROOT_PASSWORD=CHANGE_ME

# Optional — only if ghcr.io/neovisionsai/nilo-datalake is private (configure.sh 8 and 9).
# deploy.sh logs in to GHCR automatically before pulling the image.
GHCR_USER=
GHCR_TOKEN=
